#!/usr/bin/env bash

set -Eeuo pipefail

_devbox_setup_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
if [[ ! -f "$_devbox_setup_dir/../lib/import.bash" ]]; then
  printf '%s\n' "Error: Devbox importer not found: $_devbox_setup_dir/../lib/import.bash" >&2
  exit 1
fi
# shellcheck disable=SC1090
source "$_devbox_setup_dir/../lib/import.bash"
import output
unset _devbox_setup_dir

setup_ssh() {
  local port="$1"

  if [ ! -d ~/.ssh ]; then
    mkdir ~/.ssh
  fi
  cd ~/.ssh || return 1

  info "Generating SSH host RSA key..."
  ssh-keygen -t rsa -b 4096 -f ssh_host_rsa_key -N ""

  # sshd re-exec requires execution with an absolute path
  info "Starting sshd on port ${port}..."
  /usr/sbin/sshd -h ~/.ssh/ssh_host_rsa_key -p "${port}"

  success "SSH server is running on port ${port}"
}

# Ensure port argument is valid
if ! [[ "$1" =~ ^[0-9]+$ ]] || [ "$1" -lt 1024 ] || [ "$1" -gt 65535 ]; then
  error "Invalid port number. Please provide a port number between 1024 and 65535."
  exit 1
fi

setup_ssh "$1"
