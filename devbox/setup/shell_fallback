#!/usr/bin/env bash

set -Eeuo pipefail

ACTION="install"
TARGET_SHELL="zsh"
SHELL_SPECIFIED=0
RC_FILE="$HOME/.bashrc"
START_MARKER="# >>> AUTO-SHELL-SWITCH START >>>"
END_MARKER="# <<< AUTO-SHELL-SWITCH END <<<"
OLD_START_MARKER="# >>> AUTO-ZSH-SWITCH START >>>"
OLD_END_MARKER="# <<< AUTO-ZSH-SWITCH END <<<"

_devbox_setup_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
if [[ ! -f "$_devbox_setup_dir/../lib/import.bash" ]]; then
  printf '%s\n' "Error: Devbox importer not found: $_devbox_setup_dir/../lib/import.bash" >&2
  exit 1
fi
# shellcheck disable=SC1090
source "$_devbox_setup_dir/../lib/import.bash"
import output platform installer
unset _devbox_setup_dir

usage() {
  cat <<HELP
Usage: $(basename "$0") [options]

Behavior:
  - Configures ~/.bashrc to replace interactive Bash with a preferred shell.
  - Requires an executable shell listed in /etc/shells, other than Bash.
  - Checks that the target accepts -c 'exit 0' within five seconds.
  - Switches once per process tree; nested Bash shells remain Bash.
  - Skips command strings, noninteractive shells, and redirected stdin/stdout.
  - Migrates the old zsh_fallback block and preserves other ~/.bashrc content.
  - Keeps one managed target; subsequent installs replace it, never append another.
  - Serializes writes using ~/.bashrc.shell-fallback.lock (requires flock).
  - Installation is disabled on macOS; status and uninstall remain available.

Options:
  --shell <name|path>  Preferred shell, resolved at installation (default: zsh)
  -h, --help           Show this help message
  -u, --uninstall      Remove both current and legacy managed blocks
  --status            Show the installed managed block

Examples:
  $(basename "$0") --shell fish
  $(basename "$0") --shell /usr/bin/zsh
  $(basename "$0") --status
  $(basename "$0") --uninstall

To start Bash without switching: DEVBOX_SHELL_FALLBACK_ACTIVE=1 bash
The guard prevents this managed block from switching again; it cannot prevent
loops caused by unrelated commands in your target shell's startup files.
HELP
}

validate_shell() {
  local candidate registered found=0
  if [[ "$TARGET_SHELL" == */* ]]; then
    candidate="$TARGET_SHELL"
  else
    candidate="$(type -P -- "$TARGET_SHELL" || true)"
  fi
  if [[ -z "$candidate" || ! -f "$candidate" || ! -x "$candidate" ]]; then
    error "Shell is not an executable file: $TARGET_SHELL"
    return 1
  fi
  # Preserve argv[0]: some shells use the executable name to select their mode.
  SHELL_PATH="$(cd -- "$(dirname -- "$candidate")" && pwd -P)/$(basename -- "$candidate")"
  if [[ "$SHELL_PATH" == *$'\n'* || "$SHELL_PATH" == *$'\r'* ]]; then
    error "Shell paths must not contain line breaks"
    return 1
  fi
  if [[ "$SHELL_PATH" -ef "$BASH" ]]; then
    error "The target is Bash itself; no fallback is needed"
    return 1
  fi
  if [[ ! -r /etc/shells ]]; then
    error "Cannot validate the target: /etc/shells is not readable"
    return 1
  fi
  while IFS= read -r registered || [[ -n "$registered" ]]; do
    [[ "$registered" == /* && "$SHELL_PATH" -ef "$registered" ]] || continue
    case "${registered##*/}" in
    false | true | nologin | rbash | screen | tmux) continue ;;
    esac
    found=1
    break
  done </etc/shells
  if [[ "$found" != 1 ]]; then
    error "Target is not a supported login shell in /etc/shells: $SHELL_PATH"
    error "Install/register the shell first; terminal multiplexers and login blockers are not shells"
    return 1
  fi
  if ! command -v timeout >/dev/null 2>&1; then
    error "The timeout command is required to check shell startup safely"
    return 1
  fi
  if ! DEVBOX_SHELL_FALLBACK_ACTIVE=1 timeout --kill-after=1s 5s \
    "$SHELL_PATH" -c 'exit 0' </dev/null >/dev/null 2>&1; then
    error "Shell failed its startup check (-c 'exit 0', timeout: 5s): $SHELL_PATH"
    return 1
  fi
}

check_markers() {
  local start end starts ends new_start=0 new_end=0 old_start=0 old_end=0
  [[ -f "$RC_FILE" ]] || return 0
  for start in "$START_MARKER" "$OLD_START_MARKER"; do
    if [[ "$start" == "$START_MARKER" ]]; then
      end="$END_MARKER"
    else
      end="$OLD_END_MARKER"
    fi
    starts="$(grep -nFx -- "$start" "$RC_FILE" || true)"
    ends="$(grep -nFx -- "$end" "$RC_FILE" || true)"
    [[ -n "$starts$ends" ]] || continue
    if [[ -z "$starts" || -z "$ends" || "$starts" == *$'\n'* || "$ends" == *$'\n'* ]] ||
      (( ${starts%%:*} >= ${ends%%:*} )); then
      error "Malformed or duplicate managed markers in $RC_FILE; leaving it unchanged"
      return 1
    fi
    if [[ "$start" == "$START_MARKER" ]]; then
      new_start=${starts%%:*}
      new_end=${ends%%:*}
    else
      old_start=${starts%%:*}
      old_end=${ends%%:*}
    fi
  done
  if (( new_start && old_start && new_start <= old_end && old_start <= new_end )); then
    error "Overlapping managed blocks in $RC_FILE; leaving it unchanged"
    return 1
  fi
}

lock_rc() {
  if ! command -v flock >/dev/null 2>&1; then
    error "The flock command is required to prevent concurrent configuration writes"
    return 1
  fi
  # Keep the lock file: deleting it can let competing writers lock different inodes.
  # Lock a separate file because configure_rc_block may replace the rc inode.
  exec {RC_LOCK_FD}>>"${RC_FILE}.shell-fallback.lock"
  if ! flock -w 10 "$RC_LOCK_FD"; then
    error "Another shell fallback installer is updating $RC_FILE; try again later"
    return 1
  fi
}

install() {
  local content quoted_path
  if [[ "$(detect_os)" == macos ]]; then
    error "Shell fallback installation is disabled on macOS"
    return 1
  fi
  validate_shell
  lock_rc
  check_markers
  printf -v quoted_path '%q' "$SHELL_PATH"
  content='# Switch only once, and only from an interactive Bash terminal.
if [[ $- == *i* && -z "${BASH_EXECUTION_STRING:-}" &&
      -z "${DEVBOX_SHELL_FALLBACK_ACTIVE:-}" && -t 0 && -t 1 ]]; then
    _devbox_fallback_shell='"$quoted_path"'
    if [[ -f "$_devbox_fallback_shell" && -x "$_devbox_fallback_shell" &&
          ! "$_devbox_fallback_shell" -ef "$BASH" ]]; then
        # During startup, even interactive Bash can exit on a failed exec.
        _devbox_fallback_execfail=0
        shopt -q execfail && _devbox_fallback_execfail=1
        shopt -s execfail
        export DEVBOX_SHELL_FALLBACK_ACTIVE=1
        if ! exec "$_devbox_fallback_shell" -i; then
            unset DEVBOX_SHELL_FALLBACK_ACTIVE
        fi
        if [[ "$_devbox_fallback_execfail" == 0 ]]; then
            shopt -u execfail
        fi
        unset _devbox_fallback_execfail
    fi
    unset _devbox_fallback_shell
fi'
  # configure_rc_block uses sed c\ on replacement; preserve Bash quoting there.
  if [[ -f "$RC_FILE" ]] && grep -qF -- "$START_MARKER" "$RC_FILE"; then
    content="${content//\\/\\\\}"
  fi
  info "Configuring $SHELL_PATH auto-switch in $RC_FILE"
  remove_rc_block "$RC_FILE" "$OLD_START_MARKER" "$OLD_END_MARKER"
  configure_rc_block "$RC_FILE" "$START_MARKER" "$END_MARKER" "$content"
  success "Configured shell auto-switch in $RC_FILE"
}

uninstall() {
  lock_rc
  check_markers
  remove_rc_block "$RC_FILE" "$START_MARKER" "$END_MARKER"
  remove_rc_block "$RC_FILE" "$OLD_START_MARKER" "$OLD_END_MARKER"
  success "Removed shell auto-switch blocks from $RC_FILE"
}

status() {
  info "Shell auto-switch status: $RC_FILE"
  check_markers
  if [[ -f "$RC_FILE" ]] && grep -qF -- "$START_MARKER" "$RC_FILE"; then
    sed -n "/$START_MARKER/,/$END_MARKER/p" "$RC_FILE"
  elif [[ -f "$RC_FILE" ]] && grep -qF -- "$OLD_START_MARKER" "$RC_FILE"; then
    printf 'Legacy zsh block installed; run --shell <name> to migrate.\n'
  else
    printf 'No managed shell auto-switch block installed.\n'
  fi
}

while [[ $# -gt 0 ]]; do
  case "$1" in
  -h | --help) usage; exit 0 ;;
  -u | --uninstall) ACTION="uninstall"; shift ;;
  --status) ACTION="status"; shift ;;
  --shell)
    if [[ "$SHELL_SPECIFIED" == 1 ]]; then
      error "Only one --shell target is allowed"
      exit 1
    fi
    if [[ $# -lt 2 || -z "$2" || "$2" == -* ]]; then
      error "--shell requires a shell name or path"
      exit 1
    fi
    TARGET_SHELL="$2"
    SHELL_SPECIFIED=1
    shift 2
    ;;
  *) error "Unknown option: $1"; usage >&2; exit 1 ;;
  esac
done

case "$ACTION" in
install) install ;;
uninstall) uninstall ;;
status) status ;;
esac
