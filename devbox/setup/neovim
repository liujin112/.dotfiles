#!/usr/bin/env bash

set -Eeuo pipefail

_devbox_setup_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
if [[ ! -f "$_devbox_setup_dir/../lib/import.bash" ]]; then
  printf '%s\n' "Error: Devbox importer not found: $_devbox_setup_dir/../lib/import.bash" >&2
  exit 1
fi
# shellcheck disable=SC1090
source "$_devbox_setup_dir/../lib/import.bash"
import output platform installer
unset _devbox_setup_dir

function nvim_install_linux() {
  # Download the latest pre-built Neovim binaries and install them under /opt/nvim
  local tmp_dir archive
  tmp_dir="$(mktemp -d)"
  archive="$tmp_dir/nvim-linux-x86_64.tar.gz"
  trap "rm -rf '$tmp_dir'" EXIT

  curl -L --progress-bar -f \
    https://github.com/neovim/neovim/releases/latest/download/nvim-linux-x86_64.tar.gz \
    -o "$archive"
  sudo rm -rf /opt/nvim
  sudo tar -C /opt --transform='s/^nvim-linux-x86_64/nvim/' -xzf "$archive"

  rm -rf "$tmp_dir"
  trap - EXIT
}

function nvim_configure_linux() {
  # Update the given shell rc file to add Neovim's bin directory to PATH
  local content='export PATH="$PATH:/opt/nvim/bin"'
  local rc_file=$1

  configure_rc_block \
    "$rc_file" \
    "# >>> nvim initialize >>>" \
    "# <<< nvim initialize <<<" \
    "$content"
}

os="$(detect_os)"
case "$os" in
linux)
  arch="$(detect_arch)"
  if [[ "$arch" != "x86_64" ]]; then
    error "Unsupported Linux architecture: $arch"
    exit 1
  fi
  info "Installing Neovim for Linux..."
  nvim_install_linux

  info "Configuring PATH for Neovim..."
  nvim_configure_linux ~/.bashrc
  nvim_configure_linux ~/.zshrc
  success "Neovim installation and configuration complete."
  ;;
macos)
  info "Installing Neovim for MacOS via brew..."
  brew install neovim
  success "Neovim installation complete."
  ;;
*)
  error "Unsupported OS: $os"
  ;;
esac
